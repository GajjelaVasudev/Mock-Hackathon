# ==============================================================================
# Bombay Natural History Society (BNHS) - RAG Pipeline Configuration
# ==============================================================================

# Data & Knowledge Base
DATA_DIR=data
PDF_FILENAME=BNHS_Master_Clean_RAG_Knowledge_Base_25_Pages.pdf

# Vector Store Configuration
# Options: chroma, faiss
VECTORSTORE_TYPE=chroma
VECTORSTORE_DIR=vectorstore/chroma_db

# Document Chunking Settings
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# Embedding Configuration
# Options: huggingface (default local zero-cost), openai
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Retrieval Configuration
TOP_K=4
RETRIEVAL_SEARCH_TYPE=similarity

# LLM Generation Configuration
# Options: auto (detects key), openrouter, openai, gemini, anthropic, ollama, local_fallback
LLM_PROVIDER=auto
LLM_MODEL=openai/gpt-4o-mini
LLM_TEMPERATURE=0.0
MAX_TOKENS=1024

# OpenRouter API Key & Base URL
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Other API Keys
OPENAI_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama Local LLM (if using Ollama)
OLLAMA_BASE_URL=http://localhost:11434
