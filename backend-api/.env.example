# ==============================================================================
# BNHS FastAPI Backend — Environment Configuration
# ==============================================================================

# Server Configuration
PORT=8000
HOST=0.0.0.0

# MongoDB Configuration (Atlas or Local)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/BNHS
MONGODB_DATABASE=BNHS

# Conversational RAG & Chat Memory Configuration
MAX_HISTORY_MESSAGES=10
CONVERSATION_MEMORY_ENABLED=true

# OpenRouter LLM Configuration
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4o-mini
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional Alternative LLM Keys
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
